RAJAR_X_BASE_URL=https://rajarx.example.com
# Create a key in RAJAR X → API Keys with scopes: analyze, process, activity
RAJAR_X_API_KEY=
# Comma-separated WhatsApp JIDs allowed to use the bot (e.g. 15551234567@s.whatsapp.net)
BOT_ALLOWED_USERS=
# Comma-separated group JIDs (e.g. 1203630xxxxxxxx@g.us). Empty = no groups.
BOT_ALLOWED_GROUPS=
BOT_MAX_FILE_BYTES=67108864
BOT_COOLDOWN_SECONDS=60
