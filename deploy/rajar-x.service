# systemd unit for a bare-metal (non-Docker) VPS install.
# Install: sudo cp deploy/rajar-x.service /etc/systemd/system/ && sudo systemctl enable --now rajar-x
[Unit]
Description=RAJAR X YT
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=rajarx
Group=rajarx
WorkingDirectory=/opt/rajar-x-yt
EnvironmentFile=/opt/rajar-x-yt/.env
ExecStart=/usr/bin/node dist/server/server/index.js
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=40
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/tmp/rajar-x-media
CapabilityBoundingSet=
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
