# ─────────────────────────────────────────────────────────────────────────────
# RAJAR X YT — environment configuration
# Copy to .env and fill in. Never commit .env. Generate secrets with:
#   openssl rand -base64 48
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=8080
HOST=0.0.0.0
APP_VERSION=1.0.0

# Public origin users visit (used for CORS, CSRF origin checks, canonical URLs, sitemap).
# Empty on RAJAR X HOSTING: the project subdomain is used automatically.
PUBLIC_BASE_URL=
# Extra allowed browser origins / Host headers (comma-separated). Defaults derive from PUBLIC_BASE_URL.
ALLOWED_ORIGINS=
ALLOWED_HOSTS=
# Express "trust proxy" — use the address/subnet of your Nginx (e.g. "loopback", "uniquelocal", "172.18.0.0/16").
# Empty = automatic ("uniquelocal" on RAJAR X HOSTING, otherwise "loopback").
TRUST_PROXY=
# Optional: origins allowed to frame the app (embedded HTTPS preview). Leave empty to deny framing by others.
CSP_FRAME_ANCESTORS=

# ── Media engine ─────────────────────────────────────────────────────────────
# Empty = auto (./bin from `npm install`, then PATH).
YTDLP_BIN=
FFMPEG_BIN=
MEDIA_TEMP_DIR=/tmp/rajar-x-media
MEDIA_MAX_FILE_SIZE=500M
MEDIA_MAX_DURATION=7200
MEDIA_JOB_TIMEOUT_MS=900000
MEDIA_ANALYZE_TIMEOUT_MS=45000
# Max minutes an UNDOWNLOADED file is kept. Downloaded files are deleted immediately.
MEDIA_RETENTION_MINUTES=30
MEDIA_CONCURRENCY=2
MEDIA_MAX_RETRIES=2
STORAGE_MAX_BYTES=20G
# Comma-separated platform ids to disable: youtube,instagram,tiktok,x,facebook,other
PLATFORMS_DISABLED=
# Operator-approved extra public domains (enables the "Other" source). Leave empty unless legally reviewed.
MEDIA_EXTRA_ALLOWED_DOMAINS=

# ── Limits & quotas ──────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=20
USER_DAILY_JOB_QUOTA=50
USER_MAX_ACTIVE_JOBS=2
USER_MAX_API_KEYS=10
ALLOW_ANONYMOUS_ANALYZE=true
ALLOW_ANONYMOUS_PROCESSING=false
ANON_DAILY_JOB_QUOTA=2
# Allow owner/admin accounts to create keys with the "admin" scope.
ADMIN_SCOPE_ENABLED=false

# ── Data stores ──────────────────────────────────────────────────────────────
# Empty = built-in file database in DATA_DIR (no PostgreSQL/Redis server needed).
# Use postgres://… for PostgreSQL (tables are created automatically) or "memory" for throwaway demos.
DATABASE_URL=
# Optional: Redis for the job queue/rate limits across several processes. Empty = in-process queue.
REDIS_URL=
# Where the database file and generated secrets are stored (default: /data/rajar-x-yt or ./data/rajar-x-yt).
DATA_DIR=

# ── Secrets (≥32 chars). Empty = generated once and saved in DATA_DIR/secrets.json ──
SESSION_SECRET=
API_KEY_PEPPER=

# ── Accounts ─────────────────────────────────────────────────────────────────
# The account registered with this email becomes the owner (admin panel access).
# Empty = the FIRST account that registers becomes the owner.
OWNER_EMAIL=asadrajar25952595@gmail.com
# "lax" (default) | "strict" | "none" (embedded HTTPS previews; forces Secure cookies)
COOKIE_SAMESITE=lax
SESSION_TTL_HOURS=336
SUPPORT_EMAIL=support@example.com
LOG_LEVEL=info
